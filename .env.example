# Copy to .env.local and fill in. Vercel sets these per environment.
# Use a staging project for local development and previews, never production.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only, never NEXT_PUBLIC_. Service-role key of the same project;
# the answer routes write through it.
SUPABASE_SERVICE_ROLE_KEY=
# Sanity read token; required once the dataset is private.
SANITY_API_READ_TOKEN=
# Comma-separated e-mail addresses allowed to use test mode.
ADMIN_EMAILS=
# Previews/local only: open doors as if it were this date (the timer stays real).
TEST_NOW=
# Resend key for the season e-mails (reminder, winner). Production only sends
# to players; elsewhere an admin opening /api/emails/<kind> gets a sample.
RESEND_API_KEY=
# Vercel Cron sends it as a bearer token to /api/emails/*.
CRON_SECRET=
